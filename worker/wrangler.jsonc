{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "any-given-sunday",
  "account_id": "94827116f0db60b71d2e91d7b64e605e",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Serving the dashboard from a domain we own is not only cosmetic: Cache API
  // operations have no effect on workers.dev, so the standings cache in
  // src/api/cache.ts only does anything here. Cloudflare manages the DNS
  // record and certificate for a custom_domain route.
  //
  // Set explicitly rather than left to the default, which depends on whether
  // routes are present. Everything — the dashboard, /api/*, and Discord's
  // Interactions Endpoint URL — goes through ags-hq.org, so the workers.dev
  // subdomain is off. Turning it back on means a second public hostname for
  // the same Worker, one where the Cache API silently does nothing.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ags-hq.org",
      "custom_domain": true
    }
  ],
  // The league dashboard. Only the paths below reach the Worker; every other
  // asset request is served straight from the edge. The root is worker-first
  // because Discord POSTs its interactions there — the Worker hands non-POST
  // root requests back to ASSETS so index.html is still served.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "triggers": {
    // Weekly recap: Tuesdays at 11:00 UTC. That is 6-7am Eastern depending on
    // daylight saving, comfortably before the 8am Eastern delivery time the
    // email is scheduled for (see src/recap/schedule.ts). The Discord post
    // goes out when this runs, an hour or two ahead of the email.
    "crons": ["0 11 * * 2"]
  }
  // Secrets (set with `wrangler secret put <NAME>`, or .dev.vars locally):
  //   DISCORD_PUBLIC_KEY          - Discord app public key (General Information page)
  //   DISCORD_APP_ID              - Discord application ID
  //   SUPABASE_URL                - https://<project-ref>.supabase.co
  //   SUPABASE_SERVICE_ROLE_KEY   - Supabase service role key (server-side only)
  //
  // Weekly recap secrets (the cron trigger below; recap steps are skipped
  // when their secrets are absent):
  //   DISCORD_TOKEN                    - bot token, to post the recap message
  //   DISCORD_WEEKLY_RECAP_CHANNEL_ID  - channel to post the recap in
  //   RESEND_API_KEY                   - Resend API key for recap emails
  //   FROM_EMAIL                       - sender address for recap emails
  //
  // Slash commands need no bot token: interaction responses use the
  // per-interaction token, and signature checks use the public key.
}
