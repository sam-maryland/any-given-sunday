{
  "name": "any-given-sunday-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Discord interactions endpoint for the Any Given Sunday fantasy football bot",
  "type": "module",
  "scripts": {
    "build:site": "esbuild src/domain/playoffRace.ts --bundle --format=esm --minify --target=es2022 --outfile=public/race.js && esbuild src/client/site.ts --bundle --format=esm --minify --target=es2022 --outfile=public/app.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "register-commands": "node --env-file=.dev.vars scripts/register-commands.mjs",
    "backfill-activity": "esbuild scripts/backfill-activity.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.cache/backfill-activity.mjs --log-level=warning && node --env-file=.dev.vars node_modules/.cache/backfill-activity.mjs",
    "sync-players": "esbuild scripts/sync-players.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.cache/sync-players.mjs --log-level=warning && node --env-file-if-exists=.dev.vars node_modules/.cache/sync-players.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260726.1",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
