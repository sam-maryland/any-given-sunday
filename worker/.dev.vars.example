# Copy to .dev.vars for local development (never commit .dev.vars).
# In production, set each of these with: wrangler secret put <NAME>

# Slash commands
DISCORD_PUBLIC_KEY=your_discord_app_public_key
DISCORD_APP_ID=your_discord_application_id
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Weekly recap (cron trigger). Each step is skipped if its values are unset.
# DISCORD_TOKEN below is shared with the recap — the same bot posts it.
DISCORD_WEEKLY_RECAP_CHANNEL_ID=channel_id_for_automated_recaps
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=recaps@yourdomain.com

# Local safety: with this set, `wrangler dev --test-scheduled` runs the full
# recap but never posts to Discord or sends email. Do NOT set in production.
RECAP_DRY_RUN=true

# Bot token: used by the weekly recap to post, and by
# scripts/register-commands.mjs to register slash commands.
DISCORD_TOKEN=your_discord_bot_token

# Used only by scripts/register-commands.mjs (not by the Worker):
DISCORD_GUILD_ID=your_discord_server_id
